{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Model origin renewal request v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","assertion_ref"],
  "properties":{
    "schema_version":{"type":"integer","const":1},
    "request_id":{"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
    "assertion_ref":{"type":"string","pattern":"^origin:[0-9a-f]{32}$"}
  }
}
