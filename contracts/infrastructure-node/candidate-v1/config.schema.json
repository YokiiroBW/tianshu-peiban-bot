{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tianshu:infrastructure-node:candidate-v1:config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "infrastructure-node.v1"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ssh_command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "stale_after_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "nodes": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "linux",
              "synology",
              "openwrt"
            ]
          },
          "host": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.:-]{0,252}$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "user": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,63}$"
          },
          "identity_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "known_hosts_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "docker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "socket_path": {
                "type": "string",
                "pattern": "^/[^\\r\\n\\u0000]{0,4095}$"
              }
            },
            "required": [
              "enabled",
              "command",
              "socket_path"
            ]
          },
          "stacks_root": {
            "type": "string",
            "pattern": "^/[^\\r\\n\\u0000]{0,4095}$"
          }
        },
        "required": [
          "label",
          "kind",
          "host",
          "port",
          "user",
          "identity_file",
          "known_hosts_file"
        ]
      }
    }
  },
  "required": [
    "version",
    "state_dir",
    "nodes"
  ]
}
