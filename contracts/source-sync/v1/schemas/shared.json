{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tianshu.invalid/source-sync/v1/shared.json",
  "title": "source-sync/v1 1.0.0 shared",
  "$defs": {
    "key": {
      "type": "object",
      "properties": {
        "channel": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/channel_key"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "channel",
        "message_id"
      ],
      "additionalProperties": false
    },
    "head": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "generation",
        "sequence"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "properties": {
        "value": {
          "enum": [
            "real",
            "fictional",
            "mixed",
            "unclassified"
          ]
        },
        "basis": {
          "enum": [
            "registered_input_mode",
            "reviewed_source",
            "unclassified"
          ]
        },
        "policy_ref": {
          "anyOf": [
            {
              "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "basis",
        "policy_ref",
        "policy_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "const": "unclassified"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "unclassified"
              },
              "policy_ref": {
                "type": "null"
              },
              "policy_version": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "basis": {
                "enum": [
                  "registered_input_mode",
                  "reviewed_source"
                ]
              },
              "policy_ref": {
                "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
              },
              "policy_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "turn_fact": {
      "type": "object",
      "properties": {
        "turn_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "input_sources": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "delivery_state": {
          "enum": [
            "sent",
            "partial",
            "failed",
            "unknown",
            "not_required"
          ]
        },
        "reply_ids": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "committed_event": {
          "anyOf": [
            {
              "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/conversation.json#/$defs/committed_event"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "queued",
            "preparing",
            "generating",
            "waiting_dependency",
            "ready_to_send",
            "sending",
            "reconciling",
            "sent",
            "failed",
            "cancelled",
            "observed",
            "closed_unknown"
          ]
        }
      },
      "required": [
        "turn_id",
        "scope",
        "input_revision",
        "aggregate_version",
        "context_revision",
        "phase",
        "input_sources",
        "delivery_state",
        "reply_ids",
        "committed_event"
      ],
      "additionalProperties": false
    },
    "missing_source": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "https://contracts.tianshu.invalid/source-sync/v1/shared.json#/$defs/key"
        },
        "state": {
          "const": "missing"
        }
      },
      "required": [
        "key",
        "state"
      ],
      "additionalProperties": false
    },
    "missing_turn": {
      "type": "object",
      "properties": {
        "turn_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "state": {
          "const": "missing"
        }
      },
      "required": [
        "turn_id",
        "state"
      ],
      "additionalProperties": false
    },
    "viewer": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/origin"
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        }
      },
      "required": [
        "origin",
        "scope"
      ],
      "additionalProperties": false
    },
    "check_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "turn_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "input_revision": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "turn_id",
        "input_revision",
        "scope",
        "sources"
      ],
      "additionalProperties": false
    },
    "check_response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        },
        "version_domain": {
          "const": "text-dialogue/v1"
        },
        "scope_version": {
          "type": "integer",
          "minimum": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "request_digest",
        "scope",
        "version_domain",
        "scope_version",
        "checked_at"
      ],
      "additionalProperties": false
    },
    "confirmation_record": {
      "type": "object",
      "properties": {
        "confirmation_ref": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "record_id": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "account": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/account"
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        },
        "binding_version": {
          "type": "integer",
          "minimum": 1
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "consumed": {
          "type": "boolean"
        }
      },
      "required": [
        "confirmation_ref",
        "record_id",
        "semantic_digest",
        "account",
        "scope",
        "binding_version",
        "expected_version",
        "expires_at",
        "consumed"
      ],
      "additionalProperties": false
    },
    "routing_record": {
      "type": "object",
      "properties": {
        "semantic_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effective_actor_ids": {
          "type": "array",
          "items": {
            "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/id"
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "routing_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "semantic_digest",
        "effective_actor_ids",
        "routing_version"
      ],
      "additionalProperties": false
    }
  }
}
