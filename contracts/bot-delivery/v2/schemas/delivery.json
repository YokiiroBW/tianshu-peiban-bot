{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tianshu.invalid/bot-delivery/v2/delivery.json",
  "$defs": {
    "source_ref": {
      "type": "object",
      "properties": {
        "owner": {
          "enum": [
            "companion",
            "memory",
            "platform",
            "assetlibrary"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "owner",
        "object_id",
        "version"
      ],
      "additionalProperties": false
    },
    "content_ref": {
      "type": "object",
      "properties": {
        "owner": {
          "enum": [
            "companion",
            "memory",
            "assetlibrary"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "image",
            "text",
            "article",
            "video",
            "audio"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "maxItems": 64
        },
        "coverage": {
          "type": "object",
          "properties": {
            "unit": {
              "enum": [
                "bytes",
                "characters",
                "seconds",
                "pages"
              ]
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "total": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "unit",
            "start",
            "end",
            "total"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner",
        "object_id",
        "version",
        "kind",
        "sha256",
        "sources",
        "coverage"
      ],
      "additionalProperties": false
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "proactive"
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "motive_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "motive_version": {
              "type": "integer",
              "minimum": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              },
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "actor_id",
            "motive_id",
            "motive_version",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "response"
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "origin": {
              "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/origin"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              },
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "actor_id",
            "turn_id",
            "origin",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "direct"
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "direct_request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "origin": {
              "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/origin"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              },
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "actor_id",
            "direct_request_id",
            "origin",
            "sources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "segment": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reply_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "segment_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "text": {
          "type": "string",
          "maxLength": 32768
        },
        "content_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_ref"
          },
          "maxItems": 4
        }
      },
      "required": [
        "segment_id",
        "reply_id",
        "segment_sequence",
        "text",
        "content_refs"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "text": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "content_refs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "send_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "final": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/scope"
        },
        "channel": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/channel_key"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expression_id",
        "origin",
        "final",
        "scope",
        "channel",
        "segments"
      ],
      "additionalProperties": false
    },
    "send_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "final": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "queued",
            "sending",
            "sent",
            "partial",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reply_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "segment_sequence": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "queued",
                  "sending",
                  "sent",
                  "failed",
                  "unknown",
                  "cancelled"
                ]
              },
              "receipt_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retry_safe": {
                "type": "boolean"
              },
              "channel_message_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "maxItems": 16
              }
            },
            "required": [
              "segment_id",
              "reply_id",
              "segment_sequence",
              "state",
              "receipt_id",
              "retry_safe",
              "channel_message_ids"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "enum": [
                        "queued",
                        "sending",
                        "unknown",
                        "sent"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "retry_safe": {
                      "const": false
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 64
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expression_id",
        "final",
        "state",
        "segments",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "lookup_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expression_id"
      ],
      "additionalProperties": false
    },
    "lookup_response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/send_receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expression_id",
        "receipt"
      ],
      "additionalProperties": false
    },
    "finalize_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expression_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expression_id",
        "origin"
      ],
      "additionalProperties": false
    }
  }
}
