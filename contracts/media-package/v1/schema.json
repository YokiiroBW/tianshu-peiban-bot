{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tianshu.invalid/media-package/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "staging_ref",
    "library_id",
    "provider",
    "bvid",
    "layout",
    "media_extension",
    "selected_parts",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "staging_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "library_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "provider": {
      "const": "bilibili"
    },
    "bvid": {
      "type": "string",
      "pattern": "^BV[0-9A-Za-z]{10}$"
    },
    "layout": {
      "enum": [
        "single",
        "multipart"
      ]
    },
    "media_extension": {
      "enum": [
        "mp4",
        "mkv"
      ]
    },
    "selected_parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cid",
          "episode_number"
        ],
        "properties": {
          "cid": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "episode_number": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 999999
              }
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "cid",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "enum": [
              "video",
              "nfo",
              "source",
              "poster",
              "episode_thumb"
            ]
          },
          "cid": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 137438953472
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
