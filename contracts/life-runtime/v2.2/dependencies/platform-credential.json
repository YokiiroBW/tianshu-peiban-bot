{
  "path": "POST /internal/v1/service-credentials/resolve",
  "request": {
    "type": "object",
    "properties": {
      "schema_version": {
        "const": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "credential_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "audience": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "purpose": {
        "const": "companion.images"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "credential_ref",
      "audience",
      "purpose"
    ],
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "schema_version": {
        "const": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "credential_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "token": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "credential_ref",
      "token"
    ],
    "additionalProperties": false
  },
  "semantics": "复用Platform现有secret storage。只允许认证服务companion、已绑定consumer/purpose/audience的credential_ref；404表示不存在或不授予该consumer，503为不可解密。响应不进入浏览器、普通日志、观察正文、模型或数据库；Companion仅内存Transport持有。配置网页只写/见ref。凭据轮换重新解析，配置持久化保留ref。静态部署兼容旧token_env，由环境引用取值、不投影明文。"
}
