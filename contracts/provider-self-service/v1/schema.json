{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tianshu.invalid/provider-self-service/v1/schema.json",
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "uuid": {"type":"string","format":"uuid"},
    "revision": {"type":"integer","minimum":1},
    "test": {"type":"object","additionalProperties":false,"required":["revision","outcome","tested_at"],"properties":{"revision":{"$ref":"#/$defs/revision"},"outcome":{"enum":["succeeded","authentication_failed","endpoint_failed","model_not_found","timed_out","cancelled","connection_failed","unknown"]},"tested_at":{"type":"number"}}},
    "test_response": {"type":"object","additionalProperties":false,"required":["provider_id","revision","outcome","tested_at"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/revision"},"outcome":{"const":"succeeded"},"tested_at":{"type":"number"}}},
    "default_response": {"type":"object","additionalProperties":false,"required":["provider_id","provider_revision","revision"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"provider_revision":{"$ref":"#/$defs/revision"},"revision":{"$ref":"#/$defs/revision"}}},
    "error": {"type":"object","additionalProperties":false,"required":["schema_version","request_id","code","execution_state","retryable"],"properties":{"schema_version":{"const":1},"request_id":{"type":"string"},"code":{"enum":["invalid_input","unauthorized","session_expired","forbidden","management_disabled","management_required","operator_not_authorized","not_found","provider_not_found","revision_conflict","default_revision_conflict","idempotency_conflict","provider_not_tested","provider_unavailable","result_unknown","budget_exceeded","too_many_requests","timeout","dependency_unavailable","web_not_configured","provider_store_unavailable","authentication_failed","endpoint_failed","model_not_found","enumeration_unsupported","connection_failed","timed_out","upstream_invalid","upstream_rejected"]},"execution_state":{"enum":["not_started","unknown"]},"retryable":{"type":"boolean"}}},
    "provider": {"type":"object","additionalProperties":false,"required":["provider_id","name","protocol","base_url","model_id","enabled","revision","has_key","test"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":120},"protocol":{"const":"openai-chat-completions"},"base_url":{"type":"string","pattern":"^https://"},"model_id":{"type":"string","maxLength":256},"enabled":{"type":"boolean"},"revision":{"$ref":"#/$defs/revision"},"has_key":{"type":"boolean"},"test":{"anyOf":[{"$ref":"#/$defs/test"},{"type":"null"}]}}},
    "default": {"type":"object","additionalProperties":false,"required":["provider_id","revision","provider_revision","configured"],"properties":{"provider_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"revision":{"type":"integer","minimum":0},"provider_revision":{"anyOf":[{"$ref":"#/$defs/revision"},{"type":"null"}]},"configured":{"type":"boolean"}}},
    "view_response": {"type":"object","additionalProperties":false,"required":["providers","default"],"properties":{"providers":{"type":"array","items":{"$ref":"#/$defs/provider"}},"default":{"$ref":"#/$defs/default"}}},
    "save_request": {"type":"object","additionalProperties":false,"required":["client_id","name","protocol","base_url","model_id","enabled"],"properties":{"client_id":{"$ref":"#/$defs/uuid"},"provider_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"},"name":{"type":"string","minLength":1,"maxLength":120},"protocol":{"const":"openai-chat-completions"},"base_url":{"type":"string","pattern":"^https://"},"model_id":{"type":"string","maxLength":256},"enabled":{"type":"boolean"},"api_key":{"type":"string","maxLength":8192}}},
    "provider_mutation_request": {"type":"object","additionalProperties":false,"required":["client_id","provider_id","expected_revision"],"properties":{"client_id":{"$ref":"#/$defs/uuid"},"provider_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"}}},
    "models_request": {"type":"object","additionalProperties":false,"required":["provider_id","expected_revision"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"}}},
    "models_response": {"type":"object","additionalProperties":false,"required":["provider_id","revision","models"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/revision"},"models":{"type":"array","maxItems":4096,"items":{"type":"string","minLength":1,"maxLength":512}}}},
    "default_request": {"type":"object","additionalProperties":false,"required":["client_id","provider_id","expected_revision","expected_default_revision"],"properties":{"client_id":{"$ref":"#/$defs/uuid"},"provider_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"},"expected_default_revision":{"type":"integer","minimum":0}}},
    "select_request": {"type":"object","additionalProperties":false,"required":["turn_id","actor_id","person_id","audience","conversation_id","caller_service","workload"],"properties":{"turn_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},"person_id":{"$ref":"#/$defs/id"},"audience":{"enum":["group","self_private"]},"conversation_id":{"$ref":"#/$defs/id"},"caller_service":{"const":"companion"},"workload":{"const":"companion.text"}}},
    "select_response": {"type":"object","additionalProperties":false,"required":["config_version","expires_at","revoked","caller_service","workload"],"properties":{"config_version":{"$ref":"#/$defs/revision"},"expires_at":{"type":"number"},"revoked":{"const":false},"caller_service":{"const":"companion"},"workload":{"const":"companion.text"}}},
    "runtime_request": {"type":"object","additionalProperties":false,"required":["config_version","turn_id","caller_service","workload"],"properties":{"config_version":{"$ref":"#/$defs/revision"},"turn_id":{"$ref":"#/$defs/id"},"caller_service":{"const":"companion"},"workload":{"const":"companion.text"}}},
    "runtime_response": {"type":"object","additionalProperties":false,"required":["config_version","provider_id","provider_revision","protocol","base_url","model_id","api_key","usable_until"],"properties":{"config_version":{"$ref":"#/$defs/revision"},"provider_id":{"$ref":"#/$defs/id"},"provider_revision":{"$ref":"#/$defs/revision"},"protocol":{"const":"openai-chat-completions"},"base_url":{"type":"string","pattern":"^https://"},"model_id":{"type":"string","minLength":1},"api_key":{"type":"string","minLength":1},"usable_until":{"type":"number"}}},
    "gateway_context": {"type":"object","additionalProperties":false,"required":["provider_id","revision","protocol","base_url","model_id","api_key"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"revision":{"$ref":"#/$defs/revision"},"protocol":{"const":"openai-chat-completions"},"base_url":{"type":"string","pattern":"^https://"},"model_id":{"type":"string"},"api_key":{"type":"string","minLength":1}}},
    "gateway_models_response": {"type":"object","additionalProperties":false,"required":["models"],"properties":{"models":{"type":"array","items":{"type":"string"}}}},
    "gateway_test_response": {"type":"object","additionalProperties":false,"required":["outcome"],"properties":{"outcome":{"const":"succeeded"}}}
  }
}
