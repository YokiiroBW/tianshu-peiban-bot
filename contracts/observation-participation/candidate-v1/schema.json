              "$ref": "#/$defs/author_anchor"
            },
            {
              "properties": {
                "stage": {
                  "enum": [
                    "registered",
                    "resolved"
                  ]
                }
              }
            }
          ]
        },
        "configuration": {
          "$ref": "#/$defs/configuration"
        },
        "admission": {
