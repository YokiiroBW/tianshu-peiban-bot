        },
        "registration_id": {
          "$ref": "#/$defs/id"
        },
        "candidate": {
          "$ref": "#/$defs/candidate_ref"
        },
        "decision": {
          "$ref": "#/$defs/decision_ref"
        },
        "claim": {
