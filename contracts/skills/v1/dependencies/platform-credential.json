{
  "path": "POST /internal/v1/service-credentials/resolve",
  "request": {
    "type": "object",
    "properties": {
      "schema_version": {
        "const": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "credential_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "audience": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "purpose": {
        "const": "companion.skills"
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "credential_ref",
      "audience",
      "purpose"
    ],
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "schema_version": {
        "const": 1
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "credential_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "token": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "required": [
      "schema_version",
      "request_id",
      "credential_ref",
      "token"
    ],
    "additionalProperties": false
  },
  "semantics": "Reuse Platform encrypted credential storage and service authentication. Bind Companion consumer, companion.skills purpose and exact configured origin audience. Resolve tokens only into in-memory transport; never return them to browsers, model context, regular logs or domain records."
}
