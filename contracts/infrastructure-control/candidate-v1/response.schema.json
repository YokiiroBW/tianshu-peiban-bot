          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 2000
        },
        "restores_data": {
          "const": false
        }
      },
      "required": [
        "version_id",
        "stack_id",
        "created_at",
        "operation_id",
        "revision",
        "images",
        "restores_data"
      ]
    }
  }
}
