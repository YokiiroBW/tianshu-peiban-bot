{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tianshu:persona-management:v1:request",
  "title": "Persona readonly request v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "get"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operation",
        "subject",
        "request_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "history_page"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "revisions",
            "publications",
            "approvals",
            "rollbacks"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "operation",
        "subject",
        "request_id",
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "revision"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "operation",
        "subject",
        "request_id",
        "revision_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "compare"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "left": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "right": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "operation",
        "subject",
        "request_id",
        "left",
        "right"
      ],
      "additionalProperties": false
    }
  ]
}
