{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tianshu.invalid/life-autonomy/v1/autonomy.json",
  "$defs": {
    "schedule_entry": {
      "type": "object",
      "properties": {
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "controls": {
          "type": "object",
          "properties": {
            "window": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sheer": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "curtain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "desk_light": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ceiling_light": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "minute",
        "activity"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/schedule_entry"
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "reason_code": {
          "enum": [
            null,
            "generation_disabled",
            "gateway_unavailable",
            "model_unavailable",
            "diary_disabled"
          ]
        }
      },
      "required": [
        "enabled",
        "available",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "properties": {
        "plan_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "phase_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "activity_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "activity_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plan_id",
        "phase_id",
        "phase_state",
        "generation_state",
        "activity_id",
        "activity_state",
        "reason_code"
      ],
      "additionalProperties": false
    },
    "routine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "role_enabled": {
          "type": "boolean"
        },
        "autonomous": {
          "type": "boolean"
        },
        "diary_enabled": {
          "type": "boolean"
        },
        "diary_setting": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "schedule_version": {
          "type": "integer",
          "minimum": 1
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "diary_generation": {
          "$ref": "#/$defs/generation"
        },
        "current": {
          "$ref": "#/$defs/current"
        },
        "recipe": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "min_events": {
              "type": "integer",
              "minimum": 0
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "version",
            "min_events",
            "max_chars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version",
        "role_enabled",
        "autonomous",
        "diary_enabled",
        "diary_setting",
        "timezone",
        "schedule_version",
        "schedule",
        "generation",
        "diary_generation",
        "current",
        "recipe"
      ],
      "additionalProperties": false
    },
    "material_capture": {
      "type": "object",
      "properties": {
        "selection": {
          "enum": [
            "complete",
            "bounded"
          ]
        },
        "selected_events": {
          "type": "integer",
          "minimum": 0
        },
        "total_events": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_private_events": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_events": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "selection",
        "selected_events",
        "total_events",
        "excluded_private_events",
        "omitted_events",
        "bytes"
      ],
      "additionalProperties": false
    },
    "diary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "day": {
          "type": "string",
          "format": "date"
        },
        "state": {
          "enum": [
            "queued",
            "generating",
            "draft",
            "published",
            "interrupted",
            "unavailable",
            "failed",
            "skipped",
            "material_overflow"
          ]
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "current_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "published_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "number"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_retry_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_capture": {
          "$ref": "#/$defs/material_capture"
        }
      },
      "required": [
        "id",
        "version",
        "actor_id",
        "day",
        "state",
        "config_version",
        "current_revision",
        "published_revision",
        "created_at",
        "failure_code",
        "attempt_count",
        "next_retry_at",
        "material_capture"
      ],
      "additionalProperties": false
    },
    "diary_revision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "diary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "diary_version": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "number"
        },
        "fictional": {
          "const": true
        },
        "material_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "published": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "diary_id",
        "diary_version",
        "content",
        "created_at",
        "fictional",
        "material_version",
        "published"
      ],
      "additionalProperties": false
    },
    "read_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "query": {
          "$ref": "https://contracts.tianshu.invalid/text-dialogue/v1/common.json#/$defs/query"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource": {
          "enum": [
            "routine",
            "diaries",
            "diary_revision"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "query",
        "actor_id",
        "resource",
        "limit",
        "after",
        "object_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resource": {
                "const": "routine"
              }
            }
          },
          "then": {
            "properties": {
              "after": {
                "type": "null"
              },
              "object_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource": {
                "const": "diaries"
              }
            }
          },
          "then": {
            "properties": {
              "object_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource": {
                "const": "diary_revision"
              }
            }
          },
          "then": {
            "properties": {
              "after": {
                "type": "null"
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "read_response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource": {
          "enum": [
            "routine",
            "diaries",
            "diary_revision"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "actor_id",
        "resource",
        "items",
        "next_cursor",
        "observed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resource": {
                "const": "routine"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/routine"
                }
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource": {
                "const": "diaries"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "$ref": "#/$defs/diary"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource": {
                "const": "diary_revision"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/diary_revision"
                }
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "configure_value": {
      "type": "object",
      "properties": {
        "autonomous": {
          "type": "boolean"
        },
        "diary_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        }
      },
      "required": [
        "autonomous",
        "diary_enabled",
        "schedule"
      ],
      "additionalProperties": false
    },
    "manage_request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "enum": [
            "routine.configure",
            "diary.retry"
          ]
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "actor_id",
        "operation",
        "expected_version",
        "value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "routine.configure"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/configure_value"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "diary.retry"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "manage_response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "enum": [
            "routine.configure",
            "diary.retry"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "operation_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "version",
            "state",
            "operation_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "actor_id",
        "operation",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
