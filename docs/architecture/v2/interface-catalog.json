{
  "version": "2.0-design",
  "date": "2026-09-14",
  "status": "proposed_contracts_not_implemented",
  "authority": "../tianshu-system-architecture-v2.md",
  "naming_note": "operation 是拟议稳定能力名，不是已部署 URL。实现时再定 OpenAPI、MCP 工具名及客户端版本。",
  "owners": ["platform", "core", "memory", "model_gateway", "nonebot", "assetlibrary", "chat_audit", "external"],
  "common": {
    "schema_version": 1,
    "identifiers": ["request_id", "event_id", "principal_id", "person_id", "actor_id", "world_id", "conversation_id", "turn_id", "project_id", "asset_id"],
    "query": ["request_id", "schema_version", "scope", "selection", "budget", "cursor_optional"],
    "command": ["request_id", "schema_version", "idempotency_key", "target", "expected_version_if_state_mutation", "deadline_at", "payload"],
    "event": ["event_id", "schema_version", "event_type", "owner", "aggregate_id", "aggregate_version", "occurred_at", "causation_id", "payload"],
    "server_auth_context": ["authenticated_principal_or_service", "verified_origin_person_optional", "verified_actor_optional", "allowed_scope", "allowed_capabilities"],
    "auth_rule": "身份及范围由服务端认证和已登记渠道映射确定；请求 payload 的 actor/person 不授予权限。跨服务保留并验证原调用来源，不以平台服务账号扩大最终用户权限。",
    "job_ref": ["owner", "job_id"],
    "result_states": ["accepted", "running", "succeeded", "partially_failed", "failed", "cancelled", "unknown"],
    "errors": ["invalid_input", "unauthorized", "forbidden", "not_found", "version_conflict", "scope_changed", "budget_exceeded", "queue_full", "timeout", "dependency_unavailable", "result_unknown"],
    "errors_note": "对无权访问者，not_found/forbidden 不泄漏隐藏记录是否存在；内部审计可以保留真实原因。",
    "event_delivery": "at_least_once; durable outbox; deduplicate event_id; on version gap reload snapshot",
    "mutation_retry": "幂等键和原结果持久关联；相同键不同 payload 拒绝。上游不支持幂等且结果不明时，先核对或要求人工处理，禁止盲目重放。",
    "compatibility": "新增可选字段向后兼容；删除、改语义或必填字段升级 schema 主版本。测试消费者当前版及支持的前一版。",
    "browser_delivery": "同源 API 聚合；常见状态订阅优先 SSE，断线按游标恢复或重取快照；不把 provider key 送入浏览器。",
    "timeouts": "按能力配置，不设全系统同一超时。长任务返回 job_ref；状态不明不等于失败；模型流遵循原生协议。"
  },
  "interfaces": [
    {"id":"I01","operation":"conversation.ingest","owner":"core","callers":["nonebot","platform"],"mode":"command","request":["channel_message_id","channel_account_id","conversation_id","ordered_parts","author_refs","reply_refs","received_at"],"response":["receipt_id","deduplicated","collection_id"],"invariant":"服务端解析人物；保留消息边界、作者和媒体引用。网页输入同样归一化。","acceptance_refs":["A01","A03"]},
    {"id":"I02","operation":"conversation.send","owner":"nonebot","callers":["core"],"mode":"command","request":["turn_id","conversation_id","sequence","segments","idempotency_key"],"response":["receipt_state","channel_message_ids","observed_at"],"invariant":"按序发送，平台回执不明时不盲目重发；独立功能入口也遵守唯一回复责任。","acceptance_refs":["A04","A06"]},
    {"id":"I03","operation":"identity.resolve_and_link","owner":"memory","callers":["core","nonebot","platform"],"mode":"query_or_command","request":["platform_namespace","immutable_account_id","verified_link_proof_for_merge"],"response":["person_id","binding_version","selected_display_fields"],"invariant":"查找与合并为不同操作；跨平台合并需验证，昵称或头像不能作合并证据。","acceptance_refs":["A01"]},
    {"id":"I04","operation":"memory.select","owner":"memory","callers":["core","platform","external"],"mode":"query","request":["actor_id","person_id_optional","audience","conversation_or_project_scope","query","field_selection","known_versions","token_and_byte_budget"],"response":["selected_units","dependency_groups","record_versions","scope_version","source_refs","budget_used","omissions"],"invariant":"先范围后检索，完整语义组同取同舍；零画像合法，不按条 RPC，不默认整张画像。","acceptance_refs":["A02","A05"]},
    {"id":"I05","operation":"memory.revise","owner":"memory","callers":["core","platform","external"],"mode":"command","request":["record_id","expected_version","revision_kind","evidence_refs","payload"],"response":["record_version","scope_version","index_state"],"invariant":"先写权威修订/删除，再异步更新索引；查询检查当前版本。模型提议与已确认修订分开。","acceptance_refs":["A05"]},
    {"id":"I06","operation":"audit.messages_and_evidence","owner":"chat_audit","callers":["nonebot","memory"],"mode":"command_or_query","request":["channel_message_key_or_evidence_refs","authorized_scope"],"response":["archive_receipt_or_scoped_evidence","source_locator","archive_state"],"invariant":"归档与读取是不同授权操作；入口可采用现有 OneBot 接入而不是新造接口；私密原文不会因持有引用就开放。","acceptance_refs":["A02","A05"]},
    {"id":"I07","operation":"life.snapshot_and_command","owner":"core","callers":["platform"],"mode":"query_or_command","request":["actor_or_world_or_room_id","expected_version_for_command","operation","payload"],"response":["state","version","time_basis","manual_override","observed_at"],"invariant":"生活与场景同源；预览时间不提交命令；不同浏览器冲突显式处理。","acceptance_refs":["A07","A08"]},
    {"id":"I08","operation":"writing.create_and_read","owner":"core","callers":["platform"],"mode":"query_or_command","request":["actor_id","work_id_optional","recipe_version","material_refs","audience","access_decision_ref_optional"],"response":["job_ref_or_authorized_content","content_version","source_refs"],"invariant":"日记授权在服务端读全文前检查；草稿/发布分开，虚构标识保留。","acceptance_refs":["A09"]},
    {"id":"I09","operation":"capability.invoke","owner":"platform","callers":["core"],"mode":"command","request":["capability","target_id","arguments","verified_origin_ref","concrete_plan_ref_if_required"],"response":["job_ref_or_result","receipt_state","observed_state_optional"],"invariant":"明确网页操作也复用同一执行函数；目标与参数校验，回执不能冒充真实设备反馈。","acceptance_refs":["A10","A12"]},
    {"id":"I10","operation":"function.invoke","owner":"nonebot","callers":["core"],"mode":"command","request":["registered_function","verified_origin_ref","conversation_id","arguments","reply_owner"],"response":["result_or_job_ref","delivery_owner"],"invariant":"GsCore 与群功能复用直接指令执行者；是否绕过陪伴不改变实际权限。","acceptance_refs":["A06"]},
    {"id":"I11","operation":"research.ingest_and_query","owner":"memory","callers":["core","platform","external"],"mode":"query_or_command","request":["source_url_or_asset_ref","source_version_optional","project_scope_optional","research_notes_optional"],"response":["job_ref_or_selected_sources","source_versions","semantic_units","note_kind"],"invariant":"网页/文件/研究写回同一管线，原文/推论/项目采用分开；外部 MCP 写回仅记录确实提交的材料。","acceptance_refs":["A13","A14"]},
    {"id":"I12","operation":"assets.plan_and_publish","owner":"assetlibrary","callers":["platform"],"mode":"query_or_command","request":["registered_source_or_staging_ref","library_id","operation","expected_source_revision","approved_plan_ref_if_required"],"response":["plan_or_job_ref","asset_ids","file_stage","index_stage"],"invariant":"计划与执行分离；受管目录由 AssetLibrary 发布，下载器不竞争移动；相似不直接判重复。","acceptance_refs":["A11","A12"]},
    {"id":"I13","operation":"image.generate","owner":"platform","callers":["core"],"mode":"command","request":["actor_id","outfit_id","life_state_version","workflow_template_version","typed_parameters","reference_asset_ids"],"response":["job_ref","backend","asset_ids_on_completion","workflow_receipt"],"invariant":"ComfyUI 连接器在平台，生成意图与衣橱状态在核心；模板约束节点参数，GPU 单独排队。","acceptance_refs":["A09"]},
    {"id":"I14","operation":"model.configure_and_bind","owner":"platform","callers":["platform"],"mode":"query_or_command","request":["provider_configuration_or_workload_binding","expected_version"],"response":["config_version","redacted_provider","capability_verification_state"],"invariant":"管理浏览器仅提交新凭据/获得脱敏显示；服务端密钥存储，已开始轮次保留配置快照。","acceptance_refs":["A14"]},
    {"id":"I15","operation":"model.invoke_native","owner":"model_gateway","callers":["core","memory","platform","external"],"mode":"native_stream_or_request","request":["protocol","requested_model_or_explicit_workload_binding","native_payload","routing_constraints"],"response":["native_response_or_stream","route_receipt","usage_known_or_unknown"],"invariant":"保留原生模型/思考/工具语义；外部客户端不强制业务事件封装，状态引用黏性和向量空间固定。","acceptance_refs":["A14"]},
    {"id":"I16","operation":"projects.context_and_handoff","owner":"platform","callers":["external","core"],"mode":"query_or_command","request":["project_id","workspace_id","git_revision_or_working_state","task_id","context_selection_or_handoff"],"response":["context_package","source_refs","checkpoint_version","workspace_binding"],"invariant":"Git 文档、当前任务和记忆索引区分；并行任务独立工作目录，外部工具需实际接入协议。","acceptance_refs":["A13"]},
    {"id":"I17","operation":"jobs.project_and_control","owner":"platform","callers":["core","memory","assetlibrary","platform"],"mode":"event_query_or_command","request":["owner","job_id","cursor_or_control"],"response":["projection","owner_receipt","freshness"],"invariant":"事件汇总只建投影；取消/重试转责任方，未知执行结果不能在中心被改成成功。","acceptance_refs":["A12"]},
    {"id":"I18","operation":"conversation.cancel_or_resolve","owner":"core","callers":["nonebot","platform"],"mode":"command","request":["conversation_id","target_turn_or_intent","operation","source_message_ref","expected_version_optional"],"response":["new_state","already_executed_actions","remaining_cancellation"],"invariant":"明确取消/完成走及时通道；不能撤销已发生外部事实，普通新消息不触发取消。","acceptance_refs":["A03","A04","A05"]}
  ],
  "events": [
    {"name":"life.state_changed","owner":"core","consumers":["platform","memory"]},
    {"name":"conversation.turn_committed","owner":"core","consumers":["memory","platform"]},
    {"name":"memory.revised","owner":"memory","consumers":["core","platform"]},
    {"name":"knowledge.source_indexed","owner":"memory","consumers":["platform","core"]},
    {"name":"asset.published","owner":"assetlibrary","consumers":["platform","core","memory"]},
    {"name":"job.stage_changed","owner":"dynamic_job_owner","consumers":["platform"]},
    {"name":"model.usage_recorded","owner":"model_gateway","consumers":["platform"]}
  ],
  "event_scope_note": "事件同样有受众和可见范围；只发布所需引用与字段。life 事件用于历史索引，不允许记忆回写当前 world/room。",
  "deferred": ["可选独立客户端的实时音频/观影协议", "实际 OpenAPI 路径和鉴权实现", "精确超时与召回数值预算", "外部系统当前版本写接口验证", "迁移脚本与生产部署"]
