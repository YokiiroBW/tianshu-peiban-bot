    {"id":"other_actor_reply","actor_id":"example-actor-b","workload":"companion.reply","expected_model_id":"b-dialogue"},
    {"id":"diary_is_separate","actor_id":"example-actor-b","workload":"writing.diary","expected_model_id":"b-writing"},
    {"id":"memory_organizing_is_separate","actor_id":"example-actor-a","workload":"memory.organize","expected_model_id":"b-dialogue"}
