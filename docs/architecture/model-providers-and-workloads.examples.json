    {"id":"b-dialogue","provider_id":"provider-b","upstream_model_id":"dialogue-example","invocation_protocol":"chat_completions","kind":"text_generation","capabilities":["text_input","text_output","tool_calls","structured_output","streaming"],"capability_basis":"fictional_example_only"},
    {"id":"b-writing","provider_id":"provider-b","upstream_model_id":"writing-example","invocation_protocol":"chat_completions","kind":"text_generation","capabilities":["text_input","text_output","streaming"],"capability_basis":"fictional_example_only"},
    {"id":"local-embedding","provider_id":"provider-local","upstream_model_id":"embedding-example","invocation_protocol":"embeddings","kind":"embedding","capabilities":["text_input","vector_output"],"capability_basis":"fictional_example_only","embedding_space_id":"example-space-v1","dimensions":1024}
