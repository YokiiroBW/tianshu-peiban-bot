  "cards": [
    {
      "dot": "cyan",
      "title": "每轮用记忆，检索按需要",
      "items": [
        "“晚上好”通常复用已有认识；“上周答应我的呢”必须核对相关事项与证据，当前资料已足够时可免重搜。"
      ]
    },
    {
      "dot": "emerald",
      "title": "省掉重复检索，不省版本核对",
      "items": [
        "取消、纠正、身份绑定与可见范围变化会使旧缓存失效；版本无法确认时，不用旧状态主动跟进。"
      ]
    },
    {
      "dot": "violet",
      "title": "取回不等于每次都说出来",
      "items": [
        "记忆用于理解与措辞；输出只用当前相关且允许披露的部分。检索失败、无匹配、无权使用分别处理。"
      ]
    }
