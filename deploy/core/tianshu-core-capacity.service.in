[Unit]
Description=TianShu Core exact deployment capacity guard
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 @DEPLOYMENT_ROOT@/capacity.py --config @DEPLOYMENT_ROOT@/guard/capacity.json --watch
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
