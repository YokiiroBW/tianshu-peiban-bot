{
  "schema_version": "tianshu.core.v1",
  "database": {
    "dsn_ref": "TIANSHU_DATABASE_URL",
    "connection_budget": 72,
    "roles": {
      "interactive": {
        "max_connections": 4,
        "control_connections": 2,
        "sync_connections": 2
      },
      "model-broker": {
        "max_connections": 4,
        "control_connections": 2,
        "sync_connections": 1
      },
      "bot-foreground": {
        "max_connections": 4,
        "control_connections": 2,
        "sync_connections": 2
      },
      "bot-background": {
        "max_connections": 4,
        "control_connections": 2,
        "sync_connections": 2
      },
      "independent": {
        "max_connections": 4,
        "control_connections": 2,
        "sync_connections": 2
      },
      "operations": {
        "max_connections": 1,
        "control_connections": 1,
        "sync_connections": 1
      }
    }
  },
  "http": {
    "host": "0.0.0.0",
    "port": 18446,
    "static_directory": "/opt/tianshu/web/dist",
    "max_body_bytes": 536870912,
    "drain_seconds": 30,
    "access": {
      "initial": {
        "mode": "https",
        "origin": "https://tianshu.example.invalid:18443",
        "certificate": "local"
      },
      "certificates": {
        "local": {
          "certificate_file": "/config/tls/server.crt",
          "key_file": "/config/tls/server.key"
        }
      }
    },
    "tls": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 18443,
      "certificate_file": "/config/tls/server.crt",
      "key_file": "/config/tls/server.key"
    }
  },
  "broker": {
    "host": "127.0.0.1",
    "port": 8071,
    "url": "http://127.0.0.1:8071",
    "token_ref": "TIANSHU_BROKER_TOKEN",
    "external_keys": [],
    "transport": {
      "foreground_connections": 8,
      "due_connections": 4,
      "background_connections": 24,
      "control_connections": 4,
      "roles": {
        "interactive": {
          "foreground_connections": 2,
          "due_connections": 1,
          "background_connections": 2,
          "control_connections": 2
        },
        "bot-foreground": {
          "foreground_connections": 8,
          "due_connections": 2,
          "background_connections": 2,
          "control_connections": 2
        },
        "bot-background": {
          "foreground_connections": 2,
          "due_connections": 4,
          "background_connections": 16,
          "control_connections": 2
        },
        "independent": {
          "foreground_connections": 2,
          "due_connections": 2,
          "background_connections": 8,
          "control_connections": 2
        },
        "operations": {
          "foreground_connections": 1,
          "due_connections": 1,
          "background_connections": 4,
          "control_connections": 2
        }
      }
    },
    "upstream_connections": 64,
    "diagnostic_connections": 4
  },
  "credentials": {
    "master_key_ref": "TIANSHU_MASTER_KEY"
  },
  "identity": {
    "installation_seal": "/data/state/installed",
    "setup_token_ref": "TIANSHU_SETUP_TOKEN",
    "cookie_secure": true
  },
  "worker": {
    "queue_connections": 3,
    "lanes": {
      "control": 2,
      "inbound": 2,
      "delivery": 2,
      "conversation": 2,
      "proactive": 1,
      "schedule": 1,
      "life": 1,
      "planning": 1,
      "writing": 1,
      "memory_consolidation": 1,
      "memory_index": 1,
      "memory_recovery": 1,
      "source_lifecycle": 1,
      "growth": 1,
      "images": 1,
      "reactions": 1,
      "speech": 1,
      "book_audio": 1,
      "perception": 1,
      "downloads": 1,
      "media": 1,
      "book_sources": 2,
      "comic_sources": 1,
      "video_subscriptions": 1,
      "music_playlists": 1,
      "music_navidrome": 1,
      "music_lyrics": 1,
      "comic_extensions": 1,
      "comic_cleanup": 1,
      "media_retention": 1,
      "music_library": 1,
      "plugins": 1,
      "infrastructure": 1,
      "maintenance": 1,
      "life_control": 1,
      "capability_control": 1,
      "operations": 1,
      "diary": 1
    }
  },
  "artifacts": "/data/files",
  "channels": {
    "state_directory": "/data/channels",
    "owner_url": "http://127.0.0.1:18446",
    "owner_token_ref": "TIANSHU_CHANNEL_OWNER_TOKEN",
    "listen": {
      "host": "0.0.0.0",
      "port": 18765
    }
  },
  "context": {
    "tokenizer": "o200k_base",
    "structured_seconds": 1.0
  },
  "memory": {
    "retrieval": {
      "vector": true,
      "embedding_seconds": 30.0,
      "vector_sql_seconds": 2.0,
      "ef_search": 128,
      "max_scan_tuples": 20000,
      "rerank": false,
      "rerank_seconds": 30.0
    }
  },
  "capabilities": {
    "state_directory": "/data/capabilities",
    "file_workers": 2,
    "content": {
      "browser": {
        "enabled": true,
        "contexts": 1,
        "timeout_seconds": 35,
        "chromium_sandbox": true
      }
    },
    "media": {
      "enabled": true,
      "staging_directory": "/data/media/staging",
      "engine": {
        "python": "/opt/tianshu/.venv/bin/python",
        "ffmpeg": "/usr/bin/ffmpeg",
        "ffprobe": "/usr/bin/ffprobe",
        "timeout_seconds": 7200,
        "max_bytes": 21474836480
      },
      "targets": [],
      "workers": 2,
      "storage_mappings": [],
      "import_roots": []
    },
    "plugins": {
      "package_directory": "/data/plugins",
      "comic_files": {
        "runtime_socket": "/run/tianshu/comics/control.sock",
        "defaults": {
          "import_directory": "/data/media/comic-inputs",
          "import_socket": "/run/tianshu/comics/inputs/service.sock",
          "publisher_socket": "/run/tianshu/comics/publisher/service.sock"
        }
      }
    },
    "projects": {
      "allowed_roots": [
        "/data/projects"
      ],
      "git_executable": "/usr/bin/git"
    }
  },
  "observability": {
    "loki_url": "http://127.0.0.1:13100",
    "tenant": "tianshu",
    "processes": [
      {
        "name": "loki",
        "command": [
          "/usr/local/bin/loki",
          "-config.file=/config/observability/loki.yaml"
        ]
      },
      {
        "name": "vector",
        "command": [
          "/usr/local/bin/vector",
          "--config",
          "/config/observability/vector.toml"
        ]
      },
      {
        "name": "prometheus",
        "command": [
          "/usr/local/bin/prometheus",
          "--config.file=/config/observability/prometheus.yaml",
          "--storage.tsdb.path=/data/observability/prometheus",
          "--storage.tsdb.retention.time=15d",
          "--web.listen-address=0.0.0.0:19491"
        ]
      },
      {
        "name": "grafana",
        "command": [
          "/usr/share/grafana/bin/grafana",
          "server",
          "--homepath=/usr/share/grafana",
          "--config=/config/observability/grafana.ini"
        ],
        "env_refs": {
          "GF_SECURITY_ADMIN_PASSWORD": "TIANSHU_GRAFANA_ADMIN_PASSWORD"
        }
      }
    ]
  },
  "supervisor": {
    "uid": 10001,
    "gid": 10001,
    "term_timeout_seconds": 110,
    "comics": {
      "socket": "/run/tianshu/comics/control.sock",
      "inputs": {
        "uid": 10001,
        "gid": 10001,
        "settings": "/config/comics/inputs.json"
      },
      "publisher": {
        "uid": 10001,
        "gid": 10001,
        "settings": "/config/comics/publisher.json"
      }
    },
    "roles": [
      "interactive",
      "model-broker",
      "bot-foreground",
      "bot-background",
      "independent",
      "operations"
    ]
  }
}
