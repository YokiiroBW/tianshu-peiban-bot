{
  "services": {
    "platform": {
      "image": "${INFRA_PLATFORM_IMAGE:?supply_the_reviewed_derived_image_digest}",
      "volumes": [
        {
          "type": "bind",
          "source": "${INFRA_EXECUTOR_CONFIG:?supply_the_explicit_config_file}",
          "target": "/etc/tianshu/infrastructure/executor.json",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "${INFRA_CREDENTIAL_DIRECTORY:?supply_the_explicit_credential_directory}",
          "target": "/run/infrastructure-secrets",
          "read_only": true
        }
      ],
      "tmpfs": [
        "/var/lib/tianshu/infrastructure-sampling:rw,noexec,nosuid,size=128m,uid=10001,gid=10001,mode=0700"
      ]
    }
  }
}
